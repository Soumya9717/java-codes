class Solution {
    public boolean isValid(String s) {

        String open = "";

        for (int i = 0; i < s.length(); i++) {

            char ch = s.charAt(i);

            // Opening brackets
            if (ch == '(' || ch == '{' || ch == '[') {
                open = open + ch;
            }

            // Closing brackets
            else {

                if (open.length() == 0) {
                    return false;
                }

                char last = open.charAt(open.length() - 1);

                if (ch == ')' && last != '(') {
                    return false;
                }

                if (ch == '}' && last != '{') {
                    return false;
                }

                if (ch == ']' && last != '[') {
                    return false;
                }

                // Remove last opening bracket
                open = open.substring(0, open.length() - 1);
            }
        }

        return open.length() == 0;
    }
}
